; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
config_version=5

[application]

config/name="El Nido en la Niebla"
run/main_scene="res://src/shell/shell.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

ContentDBAutoload="*res://src/narrative/content_db.gd"
GameStateAutoload="*res://src/core/game_state.gd"
GameClockAutoload="*res://src/core/game_clock.gd"
InputRouterAutoload="*res://src/input/input_router.gd"
SettingsAutoload="*res://src/core/settings/settings.gd"
AudioDirectorAutoload="*res://src/audio/audio_director.gd"
SaveServiceAutoload="*res://src/save/save_service.gd"
SceneLoaderAutoload="*res://src/scene/scene_loader.gd"
SceneDirectorAutoload="*res://src/director/scene_director.gd"

[layer_names]

3d_physics/layer_1="world_geometry"
3d_physics/layer_2="player_body"
3d_physics/layer_3="interactable"
3d_physics/layer_4="zone_sensor"
3d_physics/layer_5="zone_trigger"

[rendering]

renderer/rendering_method="forward_plus"
